# Moodle: both lines are printed by local/darimaa/cli/setup_bot.php
MOODLE_URL=https://moodle.example.mn
MOODLE_TOKEN=paste-the-token-here

# Meta (developers.facebook.com > your app)
# Page access token: Messenger API settings > Generate access tokens
FB_PAGE_ACCESS_TOKEN=paste-the-page-token-here
# App secret: App settings > Basic > App secret
FB_APP_SECRET=paste-the-app-secret-here
# Any long random text. Type the same text in the webhook settings on Meta.
FB_VERIFY_TOKEN=make-up-a-long-random-text

# Optional
FB_GRAPH_VERSION=v23.0
BOT_TIMEZONE=Asia/Ulaanbaatar

# Quiz results for teachers
# A quiz topic below this percent counts as weak.
WEAK_TOPIC_BELOW=60
# Points of the final exam. The bot shows a quiz result as an estimate out of this many points.
EXAM_POINTS=30
