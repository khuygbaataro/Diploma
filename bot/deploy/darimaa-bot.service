[Unit]
Description=Teacher & Student Assistant Messenger bot
After=network-online.target
Wants=network-online.target

[Service]
User=darimaa
Group=darimaa
WorkingDirectory=/opt/darimaa-bot
EnvironmentFile=/opt/darimaa-bot/.env
ExecStart=/opt/darimaa-bot/venv/bin/uvicorn --factory darimaa_bot.app:create_app --host 127.0.0.1 --port 8100 --proxy-headers
Restart=always
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes

[Install]
WantedBy=multi-user.target
